FROM debian:12.4

ARG POSTGRESQL_VERSION

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        bison \
        build-essential \
        flex \
        git \
        libossp-uuid-dev \
        libreadline-dev \
        libz-dev \
        make \
        patchelf \
        pkg-config \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN branch=$(echo "$POSTGRESQL_VERSION" | awk -F. '{print "REL_"$1"_"$2}') && \
    echo "branch=$branch" && \
    git config --global http.version HTTP/1.1 && \
    for i in $(seq 1 5); do \
        git clone --depth 1 --branch $branch -c advice.detachedHead=false https://git.postgresql.org/git/postgresql.git /usr/src/postgresql \
            && break || sleep 3; \
    done

WORKDIR /usr/src/postgresql

# Build PostgreSQL with minimal dynamic dependencies for maximum portability.
# Removed: --with-libxml, --with-libxslt, --with-gssapi, --with-lz4, --with-zstd
# These caused libxml2.so.2 (and others) to be required at runtime, breaking
# on distributions where the soname differs (e.g. Arch has libxml2.so.16).
#
# Removed 2026-08-14: --with-openssl too. Nothing tofa runs needs OpenSSL
# inside PostgreSQL (pg_trgm only, built-in SCRAM SHA-256, plain pg_dump,
# sqlx clients over loopback), and dropping it removes the last non-libc
# runtime library dependency a user's distro must provide.
# Kept: --with-uuid=ossp (uuid-ossp extension), --with-readline (for psql).
RUN major_version=$(echo "$POSTGRESQL_VERSION" | awk -F. '{print $1}') && \
    ./configure \
      --prefix /opt/postgresql \
      --enable-integer-datetimes \
      --enable-option-checking=fatal \
      $([ $major_version -le 16 ] && echo "--enable-thread-safety") \
      --without-gssapi \
      --without-icu \
      --without-ldap \
      --without-libxml \
      --without-libxslt \
      --without-lz4 \
      --without-openssl \
      --with-pgport=5432 \
      --without-python \
      --with-readline \
      --with-system-tzdata=/usr/share/zoneinfo \
      --with-uuid=ossp \
      --without-zstd && \
    make -j$(nproc) && \
    make install && \
    make -C contrib install

# Update binary rpath to use a relative path so Postgres finds its own libs.
RUN cd /opt/postgresql/bin && \
    rpath=$(patchelf --print-rpath postgres | sed 's|/opt/postgresql/lib|$ORIGIN/../lib|g') && \
    find ./ -type f | xargs -L 1 patchelf --set-rpath $rpath 2>/dev/null || true

RUN cp /usr/src/postgresql/COPYRIGHT /opt/postgresql

# Verify minimal dynamic dependencies
RUN echo "=== Dynamic dependencies of postgres ===" && \
    ldd /opt/postgresql/bin/postgres && \
    echo "=== Checking for problematic libs ===" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "libxml2" && echo "OK: no libxml2 dependency" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "libxslt" && echo "OK: no libxslt dependency" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "libkrb5" && echo "OK: no kerberos dependency" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "liblz4" && echo "OK: no lz4 dependency" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "libzstd" && echo "OK: no zstd dependency" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "libssl" && echo "OK: no openssl dependency" && \
    ! ldd /opt/postgresql/bin/postgres | grep -q "libcrypto" && echo "OK: no libcrypto dependency" && \
    echo "=== All checks passed ==="

# Create user and group for running tests
RUN groupadd --system --gid 1000 postgresql && \
    useradd --system --gid postgresql --uid 1000 --shell /bin/bash --create-home postgresql && \
    mkdir -p /opt/test && \
    chown postgresql:postgresql /opt/test

USER postgresql
